@{
    ViewData["Title"] = "Student Page";
}
@model IEnumerable<DemoMVC.Models.ViewModels.StudentVM>

<h2 class="mb-4">Student List</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Student</a>
<table class="table table-bordered table-hover table-striped">
    <thead class="table-dark">
        <tr>
            <th style="width:10%">Student Code</th>
            <th style="width:25%">Full Name</th>
            <th style="width:30%">Email</th>
            <th style="width:7%">Age</th>
            <th style="width:18%">FacultyName</th>
            <th style="width:10%" class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StudentCode</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Age</td>
                <td>@item.FacultyName</td>
                <td class="text-center">
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>